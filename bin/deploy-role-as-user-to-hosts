#!/bin/bash

self_path="$(readlink -f ${0})"
bin_dir="${self_path%/*}"
env_dir="${bin_dir%/*}"

cd "${env_dir}"

role="${1}"
shift
user="${1}"
shift
target_hosts="${1}"
shift
time ansible-playbook ./playbooks/deploy.yml -e target_roles="${role}" -e ansible_remote_user="${user}" -e target_hosts="${target_hosts}" "${@}"
