#!/bin/bash
# Currently no file locking is done, but multiple instances seem infeasible and
# undesirable.


function main() {
  tmpdir="/tmp/${USER}/ansible-deploy-hosts"
  rm -rf "${tmpdir}"
  mkdir -p "${tmpdir}"

  target="${1}"
  shift 1

  host_names=( $( inventory_list_hosts_for_group "${target}" ) )

  if test 0 = "${#host_names[@]}"; then
    deploy_host "${target}" "${@}"
  else
    deploy_hosts "${@}"
  fi
}

self_name="${0##*/}"
self_path="$(readlink -f ${0})"
bin_dir="${self_path%/*}"
env_dir="${bin_dir%/*}"

cd "${env_dir}"

libs=(
  'output'
  'paths'
  'inventory'
  'deploy_hosts'
)
for lib in "${libs[@]}"; do
  . lib/${lib}.sh
done


main "${@}"
