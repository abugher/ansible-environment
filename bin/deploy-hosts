#!/bin/bash
# Currently no file locking is done, but multiple instances seem infeasible and
# undesirable.


function main() {
  tmpdir="/tmp/${USER}/ansible-deploy-hosts"
  rm -rf "${tmpdir}"
  mkdir -p "${tmpdir}"

  target="${1}"
  shift 1

  host_names=( $( list_hosts ) )

  case "${self_name}" in
  deploy-hosts)
    if test 1 = "${#host_names[@]}"; then
      deploy_host "${host_names[0]}" "${@}"
    else
      deploy_hosts "${@}"
    fi
    ;;
  list-roles)
    ;&
  list-roles-explicit)
    for host in "${host_names[@]}"; do
      output "# ${host}"
      list_roles_for_host_explicit "${host}"
    done
    ;;
  list-roles-implicit)
    for host in "${host_names[@]}"; do
      output "# ${host}"
      list_roles_for_host_implicit "${host}"
    done
    ;;
  list-roles-tree)
    for host in "${host_names[@]}"; do
      output "# ${host}"
      list_roles_for_host_tree "${host}"
    done
    ;;
  *)
    fail "I don't know how to be:  '${self_name}'"
    ;;
  esac
}

self_name="${0##*/}"
self_path="$(readlink -f ${0})"
bin_dir="${self_path%/*}"
env_dir="${bin_dir%/*}"

cd "${env_dir}"

libs=(
  'output'
  'paths'
  'list_hosts'
  'list_roles'
  'deploy_hosts'
)
for lib in "${libs[@]}"; do
  . lib/${lib}.sh
done


main "${@}"
