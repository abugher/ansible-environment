#!/bin/bash
self_path="$(readlink -f ${0})"
bin_dir="${self_path%/*}"
env_dir="${bin_dir%/*}"
role_dir="${env_dir%/*}"

cd "${env_dir}"

libs=(
  'paths'
  'output'
  'inventory'
)
for lib in "${libs[@]}"; do
  . lib/${lib}.sh
done

inventory_mode="${1}"
target="${2}"

# ansible-inventory seems to always complain about broken pipes when output is
# redirected to another program.  Silence this by dropping stderr into
# /dev/null.
case "${inventory_mode}" in
  '')
    ;&
  'json')
    inventory_json_basic
    ;;
  'list-hosts')
    inventory_list_hosts
    ;;
  'list-roles')
    inventory_list_roles
    ;;
  'list-roles-for-host-explicit')
    inventory_list_roles_for_host_explicit "${target}"
    ;;
  'list-roles-for-host-tree')
    inventory_list_roles_for_host_tree "${target}"
    ;;
  'list-roles-for-role')
    inventory_list_roles_for_role "${target}"
    ;;
  'list-roles-for-host')
    ;&
  'list-roles-for-host-implicit')
    inventory_list_roles_for_host_implicit "${target}"
    ;;
  'list-hosts-for-role')
    inventory_list_hosts_for_role "${target}"
    ;;
  *)
    fail "Unknown mode of operation:  '${mode}'"
    ;;
esac
